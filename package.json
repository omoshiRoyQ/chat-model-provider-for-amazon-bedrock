{
  "name": "chat-model-provider-for-amazon-bedrock",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "2.0.1",
  "publisher": "omoshiRoyQ",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omoshiRoyQ/chat-model-provider-for-amazon-bedrock.git"
  },
  "bugs": {
    "url": "https://github.com/omoshiRoyQ/chat-model-provider-for-amazon-bedrock/issues"
  },
  "homepage": "https://github.com/omoshiRoyQ/chat-model-provider-for-amazon-bedrock#readme",
  "private": true,
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "amazon-bedrock",
    "aws",
    "language-models",
    "chat",
    "generative-ai"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "amazon-bedrock-provider",
        "displayName": "%provider.displayName%"
      }
    ],
    "commands": [
      {
        "command": "amazonBedrockProvider.showLogs",
        "title": "%command.showLogs.title%",
        "category": "%command.category%"
      },
      {
        "command": "amazonBedrockProvider.signIn",
        "title": "%command.signIn.title%",
        "category": "%command.category%"
      },
      {
        "command": "amazonBedrockProvider.showUsage",
        "title": "%command.showUsage.title%",
        "category": "%command.category%"
      },
      {
        "command": "amazonBedrockProvider.pickThinkingEffort",
        "title": "%command.pickThinkingEffort.title%",
        "category": "%command.category%"
      },
      {
        "command": "amazonBedrockProvider.pickModelVisibility",
        "title": "%command.pickModelVisibility.title%",
        "category": "%command.category%"
      },
      {
        "command": "amazonBedrockProvider.manageModelPresets",
        "title": "%command.manageModelPresets.title%",
        "category": "%command.category%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "amazonBedrockProvider.profile": {
          "type": "string",
          "default": "",
          "order": 1,
          "markdownDescription": "%config.profile.description%"
        },
        "amazonBedrockProvider.region": {
          "type": "string",
          "default": "",
          "order": 2,
          "markdownDescription": "%config.region.description%"
        },
        "amazonBedrockProvider.inferenceScope": {
          "type": "string",
          "enum": [
            "geo",
            "global"
          ],
          "enumDescriptions": [
            "%config.inferenceScope.geo%",
            "%config.inferenceScope.global%"
          ],
          "default": "geo",
          "order": 3,
          "markdownDescription": "%config.inferenceScope.description%"
        },
        "amazonBedrockProvider.modelVisibility": {
          "type": "object",
          "scope": "window",
          "order": 4,
          "default": {
            "mode": "selected",
            "providers": [
              "anthropic",
              "openai"
            ],
            "minimumVersions": {}
          },
          "additionalProperties": false,
          "required": [
            "mode",
            "providers"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "all",
                "selected"
              ]
            },
            "providers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "amazon",
                  "anthropic",
                  "cohere",
                  "deepseek",
                  "google",
                  "meta",
                  "minimax",
                  "mistral",
                  "moonshot",
                  "nvidia",
                  "openai",
                  "qwen",
                  "twelvelabs",
                  "writer",
                  "xai",
                  "zai",
                  "other"
                ]
              }
            },
            "minimumVersions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claude": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(\\.(0|[1-9][0-9]*))*(?![\\s\\S])"
                },
                "gpt": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(\\.(0|[1-9][0-9]*))*(?![\\s\\S])"
                },
                "grok": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(\\.(0|[1-9][0-9]*))*(?![\\s\\S])"
                }
              }
            }
          },
          "markdownDescription": "%config.modelVisibility.description%"
        },
        "amazonBedrockProvider.modelPresets": {
          "type": "array",
          "scope": "window",
          "order": 5,
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "modelId",
              "route",
              "effort"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "modelId": {
                "type": "string",
                "minLength": 1
              },
              "route": {
                "type": "string",
                "enum": [
                  "Geo",
                  "Global",
                  "In-Region"
                ]
              },
              "effort": {
                "type": "string",
                "enum": [
                  "default",
                  "off",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            }
          },
          "markdownDescription": "%config.modelPresets.description%"
        },
        "amazonBedrockProvider.usageResetDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31,
          "default": 1,
          "order": 6,
          "markdownDescription": "%config.usageResetDay.description%"
        },
        "amazonBedrockProvider.usageResetHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "default": 0,
          "order": 7,
          "markdownDescription": "%config.usageResetHour.description%"
        },
        "amazonBedrockProvider.customPricing": {
          "type": "object",
          "default": {},
          "order": 8,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "cacheRead": {
                "type": "number",
                "minimum": 0
              },
              "cacheWrite": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "input",
              "output"
            ]
          },
          "markdownDescription": "%config.customPricing.description%"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "compile": "pnpm run typecheck && node esbuild.mjs",
    "dev": "pnpm run compile && node scripts/dev-host.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:l10n": "node scripts/check-l10n.mjs",
    "check": "pnpm run check:licenses && pnpm run check:l10n",
    "check-model-cards": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-model-cards.mts",
    "probe-models": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/probe-models.mts",
    "vscode:prepublish": "pnpm run typecheck && pnpm run check && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "package:verified": "pnpm run test && pnpm run package && pnpm run package:ls",
    "package:ls": "vsce ls --no-dependencies",
    "verify": "pnpm run compile && pnpm test && pnpm run check && pnpm run package:ls"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/vscode": "1.106.1",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1156.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/credential-providers": "^3.1156.0"
  }
}