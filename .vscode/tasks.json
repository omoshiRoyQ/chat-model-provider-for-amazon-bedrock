{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Open Extension Development Host",
            "type": "shell",
            "command": "pnpm run dev",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "pnpm: compile",
            "type": "shell",
            "command": "pnpm run compile",
            "group": "build",
            "problemMatcher": [
                "$tsc"
            ]
        }
    ]
}